# Dependencies
node_modules/
.pnp.*
.yarn/
.pnpm-store/

# Environment files
.env
.env.*
!.env.example
!**/.env.example

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.svelte-kit/
.vite/

# Test and coverage outputs
coverage/
.nyc_output/
test-results/
playwright-report/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS and editor files
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
*.swp

# Runtime and cache files
.cache/
.tmp/
tmp/
temp/
*.tsbuildinfo

# Python helper artifacts for scripts
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Large local datasets should be stored outside git unless intentionally promoted.
datasets/raw/**
datasets/processed/**
datasets/external/**
!datasets/raw/.gitkeep
!datasets/processed/.gitkeep
!datasets/external/.gitkeep

# Common generated geospatial sidecar/cache files
*.aux.xml
*.ovr
*.qix
