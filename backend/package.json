{
  "name": "@india-open-data-gis-dashboard/backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Backend workspace for the India Open Data GIS Dashboard.",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --clear -r tsconfig-paths/register src/server.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "echo \"Backend tests are not configured yet.\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "prettier . --write --ignore-path ../.prettierignore",
    "format:check": "prettier . --check --ignore-path ../.prettierignore"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "morgan": "^1.10.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.8.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.8.3",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.17",
    "tsconfig-paths": "^3.15.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3"
  }
}
